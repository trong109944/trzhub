Options.StartTypeDropdown:OnChanged(function(Value)
	if not Value then return end
	DropdownConfig._lastType = Value
	SaveConfig(DropdownConfig)

	local maps = mapOrders[Value] or {"Trost"}
	Options.StartMapDropdown:SetValues(maps)

	local currentMap = Options.StartMapDropdown.Value
	if not table.find(maps, currentMap) then
		Options.StartMapDropdown:SetValue(maps[1])
		currentMap = maps[1]
	end

	Options.StartObjectiveDropdown:SetValues(objectives[Value] and objectives[Value][currentMap] or {"None"})
	Options.StartDifficultyDropdown:SetValues(diffLists[Value] or {"Normal"})
end)

Options.StartMapDropdown:OnChanged(function(Value)
	if not Value then return end
	local currentType = Options.StartTypeDropdown.Value
	
	Options.StartObjectiveDropdown:SetValues(objectives[currentType] and objectives[currentType][Value] or {"None"})

	DropdownConfig[currentType] = DropdownConfig[currentType] or {}
	DropdownConfig[currentType].map = Value
	SaveConfig(DropdownConfig)
end)

