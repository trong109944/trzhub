local autoStartSession = 0

local function getMyMission(targetDifficulty)
	local start = os.clock()
	while (os.clock() - start) < 2 do
		for _, mission in next, ReplicatedStorage.Missions:GetChildren() do
			if mission:FindFirstChild("Leader") and mission.Leader.Value == lp.Name then
				if not targetDifficulty or mission.Value == targetDifficulty then
					return mission
				end
			end
		end
		task.wait(0.1)
	end
	return nil
end

local mapOrders = {
	Missions = {"Shiganshina","Trost","Outskirts","Forest","Utgard","Docks","Stohess","Chapel"},
	Raids = {"Trost","Shiganshina","Stohess"},
	Waves = {"Trost"}
}

local diffLists = {
	Missions = {"Easy","Normal","Hard","Severe","Aberrant","Hardest"},
	Raids = {"Hard","Severe","Aberrant","Hardest"},
	Waves = {"Easy","Normal","Hard","Severe","Aberrant","Hardest"}
}

AutoStartGroup:AddToggle("AutoStartToggle", {
	Text = "Auto Start",
	Default = false,
	Tooltip = "Automatically starts missions/raids/waves from the lobby"
})

AutoStartGroup:AddSlider("StartDelaySlider", {
	Tooltip = "Seconds to wait before starting the next mission/raid/wave",
	Text = "Start after x seconds",
	Default = 0,
	Min = 0,
	Max = 500,
	Rounding = 0,
})

Toggles.AutoStartToggle:OnChanged(function(Value)
	getgenv().AutoStart = Value

	if Value and game.PlaceId == 14916516914 then
		autoStartSession = autoStartSession + 1
		local currentSession = autoStartSession

		task.spawn(function()
			task.wait(1) -- wait for config to load
			if not getgenv().AutoStart or autoStartSession ~= currentSession then return end

			local MAX_RETRIES = 10
			local retries = 0

			while getgenv().AutoStart and autoStartSession == currentSession do
				-- Wait the user's start delay before starting
				task.wait(Options.StartDelaySlider.Value)
				if not getgenv().AutoStart or autoStartSession ~= currentSession then break end

				for _, mission in next, ReplicatedStorage.Missions:GetChildren() do
					if mission:FindFirstChild("Leader") and mission.Leader.Value == lp.Name then
						getRemote:InvokeServer("S_Missions", "Leave")
						-- Wait for the old mission folder to be destroyed on the client
						local startDestroyWait = os.clock()
						while mission.Parent == ReplicatedStorage.Missions and (os.clock() - startDestroyWait) < 2 do
							task.wait(0.1)
						end
					end
				end

				local missionType = Options.StartTypeDropdown.Value
				local mapName = Options.StartMapDropdown.Value
				local objective = Options.StartObjectiveDropdown.Value
				local selectedDifficulty = Options.StartDifficultyDropdown.Value

				local created = false

				if selectedDifficulty == "Hardest" then
					local diffOrder = missionType == "Raids"
						and {"Aberrant", "Severe", "Hard"}
						or missionType == "Missions" and {"Aberrant", "Severe", "Hard", "Normal", "Easy"} or {"Easy"}

					for _, diff in ipairs(diffOrder) do
						if not getgenv().AutoStart or autoStartSession ~= currentSession then break end	

						getRemote:InvokeServer("S_Missions", "Create", {
							Difficulty = diff,
							Type = missionType,
							Name = mapName,
							Objective = objective
						})

						if getMyMission(diff) then
							Library:Notify({
								Title = "Auto Start",
								Description = "Selected difficulty: " .. diff,
								Time = 3
							})
							created = true
							break
						end
					end
				else
					getRemote:InvokeServer("S_Missions", "Create", {
						Difficulty = selectedDifficulty,
						Type = missionType,
						Name = mapName,
						Objective = objective
					})

					if getMyMission(selectedDifficulty) then created = true end
				end

				if not getgenv().AutoStart or autoStartSession ~= currentSession then break end

				if not created then
					retries = retries + 1
					local backoff = math.min(retries * 2, 20)

					if retries >= MAX_RETRIES then
						Library:Notify({
							Title = "Auto Start",
							Description = "Failed after " .. MAX_RETRIES .. " retries. Stopping.",
							Time = 10
						})
						getgenv().AutoStart = false
						Toggles.AutoStartToggle:SetValue(false)
						break
					end

					Library:Notify({
						Title = "Auto Start",
						Description = "Failed to create. Retry " .. retries .. "/" .. MAX_RETRIES .. " in " .. backoff .. "s",
						Time = backoff
					})
					task.wait(backoff)
					continue
				end

				retries = 0

				local activeMods = {}
				if Options.ModifiersDropdown.Value then
					for modName, isActive in pairs(Options.ModifiersDropdown.Value) do
						if isActive then table.insert(activeMods, modName) end
					end
				end	

				local mission = getMyMission()

				if mission and #activeMods > 0 then
					for _, modifier in ipairs(activeMods) do
						local isSet = false
						local checkStr = mission:GetAttribute("Modifiers") or ""
						if string.find(checkStr, modifier, 1, true) then
							isSet = true
						end

						if not isSet then
							-- Call the remote ONCE to toggle it
							getRemote:InvokeServer("S_Missions", "Modify", modifier)
							
							-- Wait up to 1.5 seconds for the attribute to replicate
							local startWait = os.clock()
							while (os.clock() - startWait) < 1.5 do
								task.wait(0.1)
								local currentMods = mission:GetAttribute("Modifiers") or ""
								if string.find(currentMods, modifier, 1, true) then
									isSet = true
									break
								end
							end
							
							-- If it's still not set (e.g. request failed or was rate-limited), try once more
							if not isSet then
								getRemote:InvokeServer("S_Missions", "Modify", modifier)
								task.wait(0.5) -- final replication wait
							end
						end
					end
				end

				task.wait(0.5)
				getRemote:InvokeServer("S_Missions", "Start")

				task.wait(1)
			end
		end)
	end
end)

