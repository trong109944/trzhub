local firstHitTime = nil

local noclip = LPH_NO_VIRTUALIZE(function()
	for _, v in pairs(lp.Character:GetDescendants()) do
		if v:IsA("BasePart") and v.CanCollide == true then
			v.CanCollide = false
		end
	end
end)

local getTitan = LPH_JIT(function(refPart)
	local dist = math.huge
	local zPos = -9e9
	local titan

	if workspace:GetAttribute("Objective") == "Stall" then
		for _, v in ipairs(workspace.Titans:GetChildren()) do -- loop through every titan and get the closest distance by changing the dist variable each time and comparing
			if (v:GetAttribute("Killed") or v:GetAttribute("Dead") or not v:FindFirstChild("HumanoidRootPart") or v.Fake.Head.CanCollide == false) or v:GetAttribute("Shifter") then continue end
			
			if v.HumanoidRootPart.Position.Z > zPos then
				zPos = v.HumanoidRootPart.Position.Z
				titan = v
			end
		end
	else
		for _, v in ipairs(workspace.Titans:GetChildren()) do
			if (v:GetAttribute("Killed") or v:GetAttribute("Dead") or not v:FindFirstChild("HumanoidRootPart") or v.Fake.Head.CanCollide == false) or v:GetAttribute("Shifter") then continue end
			
			local mag = (refPart.Position - v.HumanoidRootPart.Position).Magnitude
			if mag < dist then
				dist = mag
				titan = v
			end
		end
	end

	return titan
end)

local function getBoss()
	for _, v in ipairs(workspace.Titans:GetChildren()) do
		if v:GetAttribute("Shifter") then
			if v.Fake.Head.CanCollide == true then 
				return v
			end
		end
	end
end

local getAliveTitanCount = LPH_JIT(function()
	if not isMap then return end
	local count = 0
	for _, v in ipairs(workspace.Titans:GetChildren()) do
		if not v:GetAttribute("Killed") and not v:GetAttribute("Dead")
			and v:FindFirstChild("HumanoidRootPart")
			and v.Fake.Head.CanCollide then
			count += 1
		end
	end
	return count
end)

local isLastTitanLocked = LPH_JIT(function()
	if not isMap then return false end
	local elapsed = firstHitTime and (os.clock() - firstHitTime) or 0
	local missionLockSec = Options.LastTitanLockMissionSlider.Value
	local raidBossLockSec = Options.LastTitanLockRaidSlider.Value
	if workspace:GetAttribute("Type") == "Missions" and workspace:GetAttribute("Objective") == "Breach" then
		if not workspace.Unclimbable.Objective:FindFirstChild("Breach") then return false end
		if not rsObjectiveFolder:FindFirstChild("Protect_HQ") then return false end
		if rsObjectiveFolder.Protect_HQ.Value ~= rsObjectiveFolder.Protect_HQ:GetAttribute("Requirement") - 1 then return false end
		local limit = getgenv().AutoFarmConfig.MultiHit and getgenv().AutoFarmConfig.MultiHitAmount or 1
		return getAliveTitanCount() <= limit and elapsed < missionLockSec
	elseif workspace:GetAttribute("Type") == "Missions" and workspace:GetAttribute("Objective") == "Guard" then
		if rsObjectiveFolder.Guard.Value ~= rsObjectiveFolder.Guard:GetAttribute("Requirement") - 1 then return false end
		local limit = getgenv().AutoFarmConfig.MultiHit and getgenv().AutoFarmConfig.MultiHitAmount or 1
		return getAliveTitanCount() <= limit and elapsed < missionLockSec
	elseif workspace:GetAttribute("Type") == "Missions" and workspace:GetAttribute("Objective") == "Escort" then
		return false
	elseif workspace:GetAttribute("Type") == "Missions" then
		local limit = getgenv().AutoFarmConfig.MultiHit and getgenv().AutoFarmConfig.MultiHitAmount or 1
		return getAliveTitanCount() <= limit and elapsed < missionLockSec
	end

	if isFemaleRaid and rsObjectiveFolder:FindFirstChild("Defeat_Attack_Titan") 
	and rsObjectiveFolder.Defeat_Attack_Titan.Value == 1 
	and workspace.Unclimbable.Objective:FindFirstChild("Female_Boss")
	and workspace.Unclimbable.Objective.Female_Boss.Health.Value / workspace.Unclimbable.Objective.Female_Boss.Health:GetAttribute("Max_Health") * 100 <= 20
	and elapsed < raidBossLockSec then
		if not sentTitanLockedNoti then
			sentTitanLockedNoti = true
			Library:Notify({
				Title = "Mist Safety",
				Description = "Boss is low HP. Waiting until safe time before killing boss.",
				Time = 5
			})
		end
		return true 
	end

	if isAttackRaid and workspace.Unclimbable.Objective:FindFirstChild("Defend_Eren") and rsObjectiveFolder:FindFirstChild("Defeat_Attack_Titan")
	and workspace.Unclimbable.Objective.Defend_Eren.Health.Value / workspace.Unclimbable.Objective.Defend_Eren.Health:GetAttribute("Max_Health") * 100 <= 20 
	and elapsed < raidBossLockSec then
		if not sentTitanLockedNoti then
			sentTitanLockedNoti = true
			Library:Notify({
				Title = "Mist Safety",
				Description = "Boss is low HP. Waiting until safe time before killing boss.",
				Time = 5
			})
		end
		return true
	end

	if isArmoredRaid and workspace.Unclimbable.Objective:FindFirstChild("Armored_Boss")
	and workspace.Unclimbable.Objective.Armored_Boss.Health.Value / workspace.Unclimbable.Objective.Armored_Boss.Health:GetAttribute("Max_Health") * 100 <= 20 
	and elapsed < raidBossLockSec then
		if not sentTitanLockedNoti then
			sentTitanLockedNoti = true
			Library:Notify({
				Title = "Mist Safety",
				Description = "Boss is low HP. Waiting until safe time before killing boss.",
				Time = 5
			})
		end
		return true
	end

	if isColossalRaid and workspace.Unclimbable.Objective:FindFirstChild("Colossal_Boss")
	and rsObjectiveFolder:FindFirstChild("Defeat_Colossal_Titan")
	and workspace.Unclimbable.Objective.Colossal_Boss.Health.Value / workspace.Unclimbable.Objective.Colossal_Boss.Health:GetAttribute("Max_Health") * 100 <= 20 
	and elapsed < raidBossLockSec then
		if not sentTitanLockedNoti then
			sentTitanLockedNoti = true
			Library:Notify({
				Title = "Mist Safety",
				Description = "Boss is low HP. Waiting until safe time before killing boss.",
				Time = 5
			})
		end
		return true
	end
end)

-- part.CFrame + Vector3.new(0, 80, 0) -> moves part in world space so we always go up not with the titan's rotation
-- part.CFrame * CFrame.new(0, 80, 0) -> moves relative to titan's rotation

local disabledModeAnchor = nil

local teleportTo = LPH_NO_VIRTUALIZE(function(titanHrp, offset)
	if lp:GetAttribute("Cutscene") then return end
	if not offset then offset = Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0) end
	if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
	local movementMode = Library.Options.MovementModeDropdown.Value
	local AutoFarmConfig = getgenv().AutoFarmConfig
	local charHrp = lp.Character.HumanoidRootPart
	local targetPos = titanHrp.Position + offset

	if lp:GetAttribute("Shifting") then
		movementMode = nil
	end
	
	if movementMode == "Teleport" then
		charHrp.AssemblyLinearVelocity = Vector3.zero
		charHrp.CFrame = CFrame.new(targetPos) -- tp using cframe not position
	elseif movementMode == "Hover" then
		local dir = targetPos - charHrp.Position
		if dir.Magnitude > 0.5 then
			charHrp.AssemblyLinearVelocity = dir.Unit * math.min(AutoFarmConfig.Speed, dir.Magnitude * 14)
			-- charHrp.AssemblyLinearVelocity = dir.Unit * AutoFarmConfig.Speed
		else
			charHrp.AssemblyLinearVelocity = Vector3.zero
		end
	elseif movementMode == "Disabled" then
		if not disabledModeAnchor then
			-- First call: teleport to this titan and lock position
			charHrp.AssemblyLinearVelocity = Vector3.zero
			charHrp.CFrame = CFrame.new(targetPos)
			disabledModeAnchor = targetPos
		else
			-- Stay at anchor position
			charHrp.AssemblyLinearVelocity = Vector3.zero
			charHrp.CFrame = CFrame.new(disabledModeAnchor)
		end
	elseif lp:GetAttribute("Shifting") then
		charHrp.AssemblyLinearVelocity = Vector3.zero
		charHrp.CFrame = titanHrp.CFrame * CFrame.new(0, 0, 80)
	end
end)

