local SkillPaths = {}

for weapon, groups in pairs(Index) do
	SkillPaths[weapon] = {}

	for statName, list in pairs(groups) do
		table.sort(list, function(a, b) return tonumber(a) < tonumber(b) end)
		SkillPaths[weapon][statName] = list
	end
end

local function GetPerkRarity(perkName)
	return PerkRarityMap[perkName]
end

local function GetPerkXP(rarity, level)
	local base = Perk_Base_XP[rarity] or 0
	return base * math.max(level, 1)
end

local function UseButton(button)
	if not button or not button.Parent or not button.Visible then
		return false
	end

	if GuiService.MenuIsOpen then
		vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
		vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
		task.wait(0.5)
	end

	GuiService.SelectedObject = nil
	GuiService.SelectedObject = button

	-- wait until selected
	local t = 0
	while GuiService.SelectedObject ~= button and t < 0.2 do
		task.wait()
		t += task.wait()
	end

	if GuiService.SelectedObject ~= button then
		return false -- select failed
	end

	vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
	task.wait(0.05)
	vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)

	task.delay(0.5, function()
		GuiService.SelectedObject = nil
	end)
	return true
end

local function setPerformanceMode()
	task.spawn(function()
		local settings = settings() -- Roblox graphics settings

		settings.Rendering.QualityLevel = 1
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 100000

		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") or v:IsA("Smoke") 
			or v:IsA("Fire") or v:IsA("Sparkles") then
				v.Enabled = false
			end
		end

		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("Decal") or v:IsA("Texture") then
				v.Transparency = 1
			end
		end

		getRemote:InvokeServer("Functions", "Settings", "Damage_Indicator", "Off")
		getRemote:InvokeServer("Functions", "Settings", "Shadows", "Off")
		getRemote:InvokeServer("Functions", "Settings", "Blur", "Off")
		getRemote:InvokeServer("Functions", "Settings", "Player_Effects", "Off")
		getRemote:InvokeServer("Functions", "Settings", "Effects", 0)
		getRemote:InvokeServer("Functions", "Settings", "Music", 0)
	end)
end

local function openCrates()
	if not isLobby then return end
	task.spawn(function()
		while getgenv().OpenCrates do
			local plrData = GetPlayerData()
			local slotIdx = lp:GetAttribute("Slot")
			if not plrData or not plrData.Slots or not slotIdx or not plrData.Slots[slotIdx] then
				task.wait(1)
				continue
			end
			local inventory = plrData.Slots[slotIdx].Inventory.Items

			for crate, enabled in pairs(Options.CratesDropdown.Value) do
				if enabled and inventory[crate] ~= nil then
					for i = 1, inventory[crate] do
						getRemote:InvokeServer("S_Inventory", "Crate", crate)
						Library:Notify({
							Title = "Opened crate",
							Description = "Crate: " .. crate,
							Time = 1
						})
						task.wait(0.05)
					end
				end
			end
			task.wait(1)
		end
	end)
end



local function equipSkills()
	if not isLobby then return end

	task.spawn(function()
		while getgenv().EquipSkills do
			local plrData = GetPlayerData()
			local slotIdx = lp:GetAttribute("Slot")
			if not plrData or not plrData.Slots or not slotIdx or not plrData.Slots[slotIdx] then
				task.wait(1)
				continue
			end

			for skill, enabled in pairs(Options.AutoSkillDropdown.Value) do
				if not enabled then continue end
				local skillId = skillIds[skill]
				local hotbar = plrData.Slots[slotIdx].Skills.Hotbar

				if skillId and not table.find(hotbar, tostring(skillId)) then
					for i = 1, 5 do
						plrData = GetPlayerData()
						if plrData and plrData.Slots and plrData.Slots[slotIdx] then
							hotbar = plrData.Slots[slotIdx].Skills.Hotbar
							if hotbar[i] == nil or hotbar[i] == "" then
								getRemote:InvokeServer("S_Equipment", "Skill_State", i, tostring(skillId))
								Library:Notify({
									Title = "Equipped Skill",
									Description = skill,
									Time = 5
								})
								break
							end
						end
					end
				end
			end

			task.wait(1)
		end
	end)
end

