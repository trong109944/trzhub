LobbyGroup:AddDropdown("UseBoostsDropdown", {
	Values = BoostOptions,
	Default = {},
	Multi = true,
	Text = "Use Boosts (select which)",
	Tooltip = "Only the selected boosts will be consumed when Use Boosts is on",
})

LobbyGroup:AddToggle("AutoUseBoosts", {
	Text = "Use Boosts",
	Default = false,
	Tooltip = "Automatically consumes the selected boosts from your inventory"
})
Toggles.AutoUseBoosts:OnChanged(function(Value)
	getgenv().UseBoosts = Value
	if Value then
		task.spawn(function()
			local activeTypeMap = { xp = "XP", luck = "Luck", gold = "Gold" }
			while getgenv().UseBoosts do
				if not isLobby then break end
				local plrData = GetPlayerData()
				if not plrData or not plrData.Slots then
					task.wait(1)
					continue
				end
				local slotIdx = lp:GetAttribute("Slot")
				if not slotIdx or not plrData.Slots[slotIdx] then
					task.wait(1)
					continue
				end
				local Items = plrData.Slots[slotIdx].Inventory.Items

				local selectedUse = Options.UseBoostsDropdown.Value or {}
				local enabledUse = {}
				if type(selectedUse) == "table" then
					for name, isOn in pairs(selectedUse) do
						if isOn then enabledUse[name] = true end
					end
				end

				local useAny = next(enabledUse) == nil

				local selectedBuy = Options.BuyBoostsDropdown.Value or {}
				local enabledBuy = {}
				if type(selectedBuy) == "table" then
					for name, isOn in pairs(selectedBuy) do
						if isOn then enabledBuy[name] = true end
					end
				end

				for _, displayName in ipairs(BoostOptions) do
					if not getgenv().UseBoosts then break end
					if useAny or enabledUse[displayName] then
						local meta = BoostMeta[displayName]
						if meta then
							local activeType = activeTypeMap[meta.type]
							local activeTime = activeType and plrData.Boosts and plrData.Boosts[activeType] or 0
							if activeTime <= 10 then
								local invKey, amount = findBoostInInventory(Items, displayName)
								if invKey and amount and amount > 0 then
									getRemote:InvokeServer("S_Inventory", "Item", invKey)
									Library:Notify({
										Title = "Mist Hub",
										Description = "Used " .. invKey,
										Time = 1
									})
									task.wait(0.15)
									-- Re-fetch player data to update activeTime for the same category
									plrData = GetPlayerData()
									if plrData and slotIdx and plrData.Slots and plrData.Slots[slotIdx] then
										Items = plrData.Slots[slotIdx].Inventory.Items or Items
									end
								elseif getgenv().BuyBoosts and enabledBuy[displayName] then
									-- Buy 1 boost on-demand since we have 0 in inventory and active time is low
									local currencyName = Options.BuyBoostsCurrency.Value or "Gems"
									local currencySlot = currencyName == "Candy" and "2_Boosts" or currencyName == "Shards" and "3_Boosts" or "1_Boosts"
									local ok = getRemote:InvokeServer("S_Market", "Buy", currencySlot, meta.id, 1)
									if ok then
										Library:Notify({
											Title = "Mist Hub",
											Description = "Bought " .. displayName .. " (" .. currencyName .. ")",
											Time = 2
										})
										task.wait(0.15)
										-- Re-fetch player data to get the new item in inventory
										plrData = GetPlayerData()
										if plrData and slotIdx and plrData.Slots and plrData.Slots[slotIdx] then
											Items = plrData.Slots[slotIdx].Inventory.Items or Items
											local newInvKey, newAmount = findBoostInInventory(Items, displayName)
											if newInvKey and newAmount and newAmount > 0 then
												getRemote:InvokeServer("S_Inventory", "Item", newInvKey)
												Library:Notify({
													Title = "Mist Hub",
													Description = "Used " .. newInvKey,
													Time = 1
												})
												task.wait(0.15)
												-- Re-fetch player data again to update activeTime
												plrData = GetPlayerData()
												if plrData and slotIdx and plrData.Slots and plrData.Slots[slotIdx] then
													Items = plrData.Slots[slotIdx].Inventory.Items or Items
												end
											end
										end
									end
								end
							end
						end
					end
					task.wait(0.1)
				end
				task.wait(1)
			end
		end)
	end
end)

LobbyGroup:AddDropdown("BuyBoostsDropdown", {
	Values = BoostOptions,
	Default = {},
	Multi = true,
	Text = "Buy Boosts (select which)",
	Tooltip = "Choose which boosts to keep stocked",
