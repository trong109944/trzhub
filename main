-- Lobby Helpers & Boost Options
local BoostOptions = {
	"2X XP Boost [30M]",
	"2X XP Boost [1H]",
	"2X XP Boost [2H]",
	"2X Luck Boost [30M]",
	"2X Luck Boost [1H]",
	"2X Luck Boost [2H]",
	"2X Gold Boost [30M]",
	"2X Gold Boost [1H]",
	"2X Gold Boost [2H]",
}

local BoostMeta = {
	["2X XP Boost [30M]"]   = { type = "xp",   dur = "30",    id = 1 },
	["2X XP Boost [1H]"]    = { type = "xp",   dur = "1h",    id = 2 },
	["2X XP Boost [2H]"]    = { type = "xp",   dur = "2h",    id = 3 },
	["2X Luck Boost [30M]"] = { type = "luck", dur = "30",    id = 4 },
	["2X Luck Boost [1H]"]  = { type = "luck", dur = "1h",    id = 5 },
	["2X Luck Boost [2H]"]  = { type = "luck", dur = "2h",    id = 6 },
	["2X Gold Boost [30M]"] = { type = "gold", dur = "30",    id = 7 },
	["2X Gold Boost [1H]"]  = { type = "gold", dur = "1h",    id = 8 },
	["2X Gold Boost [2H]"]  = { type = "gold", dur = "2h",    id = 9 },
}

local function findBoostInInventory(items, displayName)
	local meta = BoostMeta[displayName]
	if not meta or not items then return nil, 0 end
	for itemName, amount in pairs(items) do
		local low = string.lower(itemName)
		local nameMatched = string.find(low, "boost") or string.find(low, "potion")
		local typeMatched = string.find(low, meta.type) or (meta.type == "xp" and string.find(low, "exp"))
		if nameMatched and typeMatched then
			if meta.dur == "30" and (string.find(low, "30") or string.find(low, "30m")) then
				return itemName, amount
			elseif meta.dur == "1h" and (string.find(low, "1h") or string.find(low, "1 h") or string.find(low, "1hour") or string.find(low, "1 hour")) and not string.find(low, "30") then
				return itemName, amount
			elseif meta.dur == "2h" and (string.find(low, "2h") or string.find(low, "2 h") or string.find(low, "2hour") or string.find(low, "2 hour")) then
				return itemName, amount
			end
		end
	end
	return nil, 0
end

