local rageModeUsed = false

local function shift()
	task.spawn(function()
		while getgenv().TitanMasteryFarm do
			if lp:GetAttribute("Bar") and lp:GetAttribute("Bar") >= lp:GetAttribute("Max_Bar") and lp:GetAttribute("Shift") and lp:GetAttribute("Shift") > 0 and not lp:GetAttribute("Shifting") then
				for i, skill in pairs(mapData.Slots[lp:GetAttribute("Slot")].Skills.Hotbar) do
					--print(skill)
					if skill == "999" then
						getRemote:InvokeServer("S_Skills", "Usage", i)
						break
					end
				end
			end
			task.wait(1)
		end
	end)
end

local function upgradeWavesGear()
	task.spawn(function()
		while getgenv().UpgradeWavesGear do
			local args = {  
			"Equipment",
			"Upgrade",
			upgradesTable[lp:GetAttribute("Weapon")]
			}

			local success = getRemote:InvokeServer(unpack(args))
			if success then
				Library:Notify({
					Title = "Upgrade Waves Gear",
					Description = "Auto upgraded " .. lp:GetAttribute("Weapon"),
					Time = 1
				})
			end
			task.wait(1)
		end
	end)
end
local function buyWavesSpears()
	if not isMap or workspace:GetAttribute("Type") ~= "Waves" then return end
	task.spawn(function()
		while getgenv().BuyWavesSpears do
			local success = getRemote:InvokeServer("Equipment", "Weapon", "Spears")
			if success then
					Library:Notify({
					Title = "Auto Buy Spears",
					Description = "Successfully bought spears",
					Time = 1
				})
			end
			task.wait(3)
		end
	end)
end

local function buyWavesUpgrades()
	if not isMap or workspace:GetAttribute("Type") ~= "Waves" then return end
	task.spawn(function()
		while getgenv().BuyWavesUpgrades do
			for i, v in pairs(Options.BuyWavesUpgradesDropdown.Value) do
				if i == "Refill" then i = "Refills" end
				if not v then continue end
				getRemote:InvokeServer("Waves", "Upgrade", { i })
				task.wait(0.2)
			end
			task.wait(1)
		end
	end)
end

local function stopAfterWaves()
	if not isMap or workspace:GetAttribute("Type") ~= "Waves" then return end
	while getgenv().StopAfterWave do
		if ReplicatedStorage.Objectives.Clearance.Value >= Options.StopAfterWaveSlider.Value then
			lp:SetAttribute("Cutscene", true)
			break
		end
		task.wait(1)
	end
end

local function hitTitan(titan, distCheck, ref)
	if isLastTitanLocked() and not isColossalRaid then return end
	local ref = ref or objective or lp.Character.HumanoidRootPart
	
	if Library.Options.MovementModeDropdown.Value == "Disabled" then distCheck = false end
	if distCheck == nil then distCheck = true end
	if isReloading or not titan or lp:GetAttribute("Cutscene") then 
		return 
	end	
	local hitDist = getgenv().AutoFarmConfig.HitDistance or 250
	if distCheck and (Vector3.new(lp.Character.HumanoidRootPart.Position.X, 0, lp.Character.HumanoidRootPart.Position.Z) - Vector3.new(titan.HumanoidRootPart.Position.X, 0, titan.HumanoidRootPart.Position.Z)).Magnitude >= hitDist then return end -- magnitude without Y basically ur hrp pos - titan pos without Y
	local weapon = lp:GetAttribute("Weapon")
	if lp:GetAttribute("Shifting") then
		weapon = "TitanPunch"
	end

	if not weapon then return end

	local now = os.clock()
	local cooldown = getgenv().AutoFarmConfig[weapon .. "CD"] or 0.1
	if (now - lastHit) < cooldown then return end -- cooldown skip is normal, no print needed

	if getgenv().MinMissionTime and startMissionTime
		and (os.clock() - startMissionTime) < Options.MinMissionTimeSlider.Value then
		return
	end

	local isBoss = titan:GetAttribute("Shifter")
	if isBoss and (titan:GetAttribute("State") == "Roar" or titan:GetAttribute("State") == "Berserk_Mode") then 
		return 
	end

	if not firstHitTime then
	firstHitTime = os.clock()
	end
	lastHit = now

	local targetPart

	if titan:FindFirstChild("Marker") and titan.Marker.Adornee ~= nil then
		targetPart = titan.Marker.Adornee
	else
		targetPart = titan.Hitboxes.Hit.Nape
	end

	if not targetPart then return end

	if getgenv().AutoSkill then
		if not usingSkills then
			local uiHotbar = PlayerGui.Interface.HUD.Main.Top[7].Hotbar
			local hotbar = mapData and mapData.Slots[lp:GetAttribute("Slot")].Skills.Hotbar
			
			usingSkills = true
			local success

			task.spawn(function()
				local selected = Options.AutoSkillDropdown.Value
				if not selected then
					usingSkills = false
					return
				end
				
				for skillName, enabled in pairs(selected) do
					if enabled then
						local id = tostring(skillIds[skillName])
						local index = table.find(hotbar, id)

						if not index then continue end

						local slotUI = uiHotbar:FindFirstChild("Skill_" .. index)
						if slotUI and slotUI:FindFirstChild("Cooldown") and slotUI.Cooldown.Visible then
							continue
						end
						
						if skillName == "Torrential Steel" or skillName == "Drill Thrust" or skillName == "Let It Rip" or skillName == "Swift Strikes" then
							lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
							local napeWelds = {}

							for _, titan in ipairs(workspace.Titans:GetChildren()) do
								if titan and titan:FindFirstChild("Fake") and titan.Fake.Head.CanCollide then
									local nape = titan.Hitboxes.Hit.Nape
									local napeWeld = titan.Hitboxes.Hit.Nape.Nape
									
									napeWeld.Enabled = false
									nape.CFrame = lp.Character.HumanoidRootPart.CFrame
									nape.Anchored = true
									table.insert(napeWelds, napeWeld)
								end
							end

							repeat
								success = getRemote:InvokeServer("S_Skills", "Usage", index)
								task.wait()
							until success
							success = nil

							task.wait(1)

							for _, weld in ipairs(napeWelds) do
								if weld and weld.Parent then
									weld.Parent.Anchored = false
									weld.Enabled = true
								end
							end
						elseif skillName == "Rage Mode" then
							if lp:GetAttribute("Bar") >= lp:GetAttribute("Max_Bar") then
								if rageModeUsed then continue end
								rageModeUsed = true

								local success
								repeat
									success = getRemote:InvokeServer("S_Skills", "Usage", index)
									task.wait()
								until success

								task.spawn(function()
									task.wait(10)

									local slotUI = uiHotbar:FindFirstChild("Skill_" .. index)
									if slotUI and slotUI:FindFirstChild("Cooldown") then
										-- wait for cooldown to appear
										repeat task.wait() until slotUI.Cooldown.Visible
										rageModeUsed = false
									end
								end)
							end
						else
							getRemote:InvokeServer("S_Skills", "Usage", index)
						end
						task.wait(3)
					end
				end
				usingSkills = false
			end)
		end
	end

	local loops = (isBoss and 5) or 1 -- 3 will ban i think

	if weapon == "Blades" then
		if getgenv().AutoFarmConfig.MultiHit then
			local sorted = {}

			for _, v in ipairs(workspace.Titans:GetChildren()) do
				if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and not v:GetAttribute("Killed") and not v:GetAttribute("Dead") and v.Fake.Head.CanCollide then
					table.insert(sorted, v)
				end
			end

			table.sort(sorted, function(a, b)
				return (ref.Position - a.HumanoidRootPart.Position).Magnitude < (ref.Position - b.HumanoidRootPart.Position).Magnitude
			end)

			postRemote:FireServer("Attacks", "Slash", true)

			for i = 1, loops do
				postRemote:FireServer("Hitboxes", "Register", targetPart, math.random(625, 850))
			end

			local idx = table.find(sorted, titan)
			if idx then table.remove(sorted, idx) end

			for i, v in ipairs(sorted) do
				local hitTarget = v:FindFirstChild("Marker") and v.Marker.Adornee ~= nil and v.Marker.Adornee or v.Hitboxes.Hit.Nape
				if i > getgenv().AutoFarmConfig.MultiHitAmount - 1 then break end -- x - 1 more titans hit
				postRemote:FireServer("Hitboxes", "Register", hitTarget, math.random(625, 850))
			end
		else
			postRemote:FireServer("Attacks", "Slash", true)
			for i = 1, loops do
				postRemote:FireServer("Hitboxes", "Register", targetPart, math.random(625, 850))
			end
		end
	elseif weapon == "Spears" then
		
		local ammo, maxAmmo = string.match(PlayerGui.Interface.HUD.Main.Top[7].Spears.Spears.Text, "(%d+)%s*/%s*(%d+)")

		if (tonumber(ammo) and tonumber(ammo) > 0) or getgenv().InfSpearsAmmo then

			task.spawn(function()
				if getgenv().AutoFarmConfig.MultiHit then
					local sorted = {}

					for _, v in ipairs(workspace.Titans:GetChildren()) do
						if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and not v:GetAttribute("Killed") and not v:GetAttribute("Dead") and v.Fake.Head.CanCollide then
							table.insert(sorted, v)
						end
					end

					table.sort(sorted, function(a, b)
						return (ref.Position - a.HumanoidRootPart.Position).Magnitude < (ref.Position - b.HumanoidRootPart.Position).Magnitude
					end)

					local function getAmmo()
						local hudText = PlayerGui.Interface.HUD.Main.Top[7].Spears.Spears.Text
						return tonumber(string.match(hudText, "(%d+)"))
					end

					local isInfActive = getgenv().InfSpearsAmmo and (tonumber(ammo) == 0 or ammo == nil)

					if isInfActive then
						getRemote:InvokeServer("Spears", "S_Fire", "1")
					else
						local beforeAmmo = getAmmo()
						getRemote:InvokeServer("Spears", "S_Fire", tostring(ammo))
						local afterAmmo = getAmmo()

						if afterAmmo and beforeAmmo and afterAmmo == beforeAmmo then
							for j = maxAmmo, 1, -1 do
								local prevAmmo = getAmmo()
								getRemote:InvokeServer("Spears", "S_Fire", tostring(j))
								local newAmmo = getAmmo()
								if newAmmo and prevAmmo and newAmmo < prevAmmo then break end
							end
						end
					end

					-- Primary target always gets its explosions
					for i = 1, loops do
						postRemote:FireServer("Spears", "S_Explode", targetPart.Position)
					end

					-- Smart Explosions: group nearby titans, 1 explosion per group
					local SMART_GROUP_RADIUS = 60
					local others = {}
					for _, v in ipairs(sorted) do
						if v ~= titan then
							table.insert(others, v)
						end
					end

					local assigned = {}
					local groups = {} -- each group = list of titans close together

					for _, v in ipairs(others) do
						if not assigned[v] then
							local group = {v}
							assigned[v] = true
							for _, other in ipairs(others) do
								if not assigned[other] then
									if (v.HumanoidRootPart.Position - other.HumanoidRootPart.Position).Magnitude <= SMART_GROUP_RADIUS then
										table.insert(group, other)
										assigned[other] = true
									end
								end
							end
							table.insert(groups, group)
						end
					end

					-- Send 1 explosion per group, up to MultiHitAmount - 1 leftover budget
					local budget = getgenv().AutoFarmConfig.MultiHitAmount - 1
					for _, group in ipairs(groups) do
						if budget <= 0 then break end
						local rep = group[1]
						local hitTarget = rep:FindFirstChild("Marker") and rep.Marker.Adornee ~= nil and rep.Marker.Adornee or rep.Hitboxes.Hit.Nape
						postRemote:FireServer("Spears", "S_Explode", hitTarget.Position)
						budget -= 1
					end
				else
					local function getAmmo()
						local hudText = PlayerGui.Interface.HUD.Main.Top[7].Spears.Spears.Text
						return tonumber(string.match(hudText, "(%d+)"))
					end

					local isInfActive = getgenv().InfSpearsAmmo and (tonumber(ammo) == 0 or ammo == nil)

					if isInfActive then
						getRemote:InvokeServer("Spears", "S_Fire", "1")
					else
						local beforeAmmo = getAmmo()
						getRemote:InvokeServer("Spears", "S_Fire", tostring(ammo))
						local afterAmmo = getAmmo()

						if afterAmmo and beforeAmmo and afterAmmo == beforeAmmo then
							for j = maxAmmo, 1, -1 do
								local prevAmmo = getAmmo()
								getRemote:InvokeServer("Spears", "S_Fire", tostring(j))
								local newAmmo = getAmmo()
								if newAmmo and prevAmmo and newAmmo < prevAmmo then break end
							end
						end
					end

					for i = 1, loops do
						postRemote:FireServer("Spears", "S_Explode", targetPart.Position)
					end
				end
			end)

		end
	elseif lp:GetAttribute("Shifting") then
		local TitanMasteryConfig = getgenv().TitanMasteryConfig
		if TitanMasteryConfig.Mode == "Use M1s" or TitanMasteryConfig.Mode == "Both" then
			postRemote:FireServer("Attacks", "Slash", true)
				postRemote:FireServer("Hitboxes", "Register", targetPart, nil, nil, titanCombo)
			
			titanCombo += 1
			if titanCombo >= 3 then
				titanCombo = 1
			end
		end

		if TitanMasteryConfig.Mode == "Use Skills" or TitanMasteryConfig.Mode == "Both" then
			task.spawn(function()
				for i, skillId in ipairs(mapData.Slots[lp:GetAttribute("Slot")].Skills.Shifter) do
					local idNum = tonumber(skillId) -- idk if its a number or a string too lazy to test
					if idNum and idNum ~= 200 and idNum ~= 300 and idNum ~= 400 and idNum ~= 210 and idNum ~= 211 and idNum ~= 306 and idNum ~= 308 and idNum ~= 402 and idNum ~= 403 and idNum ~= 407 then
						getRemote:InvokeServer("S_Skills", "Usage", i)
					end
					task.wait(0.5)
				end
			end)
		end

	end
end

local watchTowerDist = math.huge
local trackedWatchTower
local objective
local WatchTowersCache = nil

local function farmTitans()
	if lp:GetAttribute("Cutscene") or lp:GetAttribute("Ejected") then return end

	local titan = getTitan(lp.Character.HumanoidRootPart)

	if not objective then
		for i, v in ipairs(workspace.Unclimbable.Objective:GetDescendants()) do
			if v.Name == "Objective" and v:IsA("BillboardGui") then
				objective = v.Parent
				break
			end
		end
	end

	noclip()

	watchTowerDist = math.huge
	trackedWatchTower = nil

	if not WatchTowersCache then
		WatchTowersCache = {}
		for i, v in ipairs(workspace:GetChildren()) do
			if string.find(v.Name, "WatchTower") then
				table.insert(WatchTowersCache, v)
			end
		end
	end

	for i, v in ipairs(WatchTowersCache) do
		if v.Circle.Floor.Smoke1.Enabled then
			local dist = (lp.Character.HumanoidRootPart.Position - v.Circle.Hitbox.Position).Magnitude
			if dist < watchTowerDist then
				watchTowerDist = dist
				trackedWatchTower = v
			end
		end
	end
	if objective then
		titan = getTitan(objective)
	end

	if not titan or not titan:FindFirstChild("HumanoidRootPart") then 
		lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero -- counteract gravity to not fall
		return 
	end

	if trackedWatchTower then
		trackedWatchTower.Circle.Hitbox.CFrame = lp.Character.HumanoidRootPart.CFrame
		teleportTo(trackedWatchTower.Circle.Beam1, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
	else
		teleportTo(titan.HumanoidRootPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
	end

	hitTitan(titan)
end


local function farmBoss()
	if lp:GetAttribute("Cutscene") or lp:GetAttribute("Ejected") then 
		return 
	end

	local boss = getBoss()	
	if not boss or not boss:FindFirstChild("HumanoidRootPart") or not boss:GetAttribute("State") then
		lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		return 
	end

	noclip()
	teleportTo(boss.HumanoidRootPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
	hitTitan(boss)
end

local function AutoFarmMission()
	if not isMap or workspace:GetAttribute("Type") ~= "Missions" then return end
	startMissionTime = os.clock()
	task.spawn(function()
		while getgenv().AutoFarmMissions do

			local success, err = pcall(farmTitans)

			-- if not success then warn(err) end
			task.wait()
		end
	end)
end

local function checkAndDeliverCrate()
	if not getgenv().AutoDeliverCrates then return end
	if not isMap or workspace:GetAttribute("Type") ~= "Waves" then return end
	local waves = workspace:FindFirstChild("Waves")
	if not waves then return end
	local crates = waves:FindFirstChild("Crates")
	if not crates then return end
	local crateName = "Crate_" .. lp.Name
	local crate = crates:FindFirstChild(crateName)
	if crate and crate:FindFirstChild("Hitbox") then
		lp:SetAttribute("Cutscene", true)
		
		-- Teleport to pickup hitbox
		local pickupTimeout = os.clock() + 3
		while crate and crate.Parent == crates and os.clock() < pickupTimeout do
			if not getgenv().AutoFarmWaves then break end
			noclip()
			if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
				lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				lp.Character:PivotTo(crate.Hitbox:GetPivot())
			end
			task.wait(0.2)
		end
		
		-- Teleport to dropoff hitbox
		local zones = waves:FindFirstChild("Zones")
		local skills = zones and zones:FindFirstChild("Skills")
		local dropoff = skills and skills:FindFirstChild("Hitbox")
		if dropoff then
			local dropTimeout = os.clock() + 2
			while os.clock() < dropTimeout do
				if not getgenv().AutoFarmWaves then break end
				noclip()
				if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
					lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
					lp.Character:PivotTo(dropoff:GetPivot())
				end
				task.wait(0.2)
			end
		end
		
		lp:SetAttribute("Cutscene", nil)
	end
end

local function AutoFarmWaves()
	if not isMap or workspace:GetAttribute("Type") ~= "Waves" then return end
	startMissionTime = os.clock()
	task.spawn(function()
		while getgenv().AutoFarmWaves do

			local success, err = pcall(function() 
				checkAndDeliverCrate()
				local priority = getgenv().WavesKillPriority or (Options.WavesKillPriorityDropdown and Options.WavesKillPriorityDropdown.Value) or "Titans"
				if priority == "Bosses" then
					if getBoss() then
						farmBoss()
					else
						farmTitans()
					end
				else
					if getTitan(lp.Character.HumanoidRootPart) then
						farmTitans()
					else
						farmBoss()
					end
				end
			end)

			-- if not success then warn(err) end
			task.wait()
		end
	end)
end

local usingCannon
local function AutoFarmRaid()
	if not isMap or workspace:GetAttribute("Type") ~= "Raids" then return end
	startMissionTime = os.clock()

	local boats = {}
	local cannon

	for _, v in workspace.Unclimbable.Objective:GetChildren() do
		if string.find(v.Name, "Boat") then
			table.insert(boats, v)
		end
	end

	for _, v in ipairs(workspace.Climbable.Walls:GetChildren()) do
		if v.Name == "Wall" and v:FindFirstChild("Cannons") and v.Cannons:FindFirstChildOfClass("Model") then
			cannon = v.Cannons:FindFirstChildOfClass("Model")
		end
	end

	task.spawn(function()
		local success, err = pcall(function()
			while getgenv().AutoFarmRaids do
					if isAttackRaid then
						if workspace.Titans:FindFirstChild("Attack_Titan") then
							farmBoss()
						else
							farmTitans()
						end
					elseif isArmoredRaid then
						if rsObjectiveFolder:FindFirstChild("Defeat_Armored_Titan") then
							farmBoss()
						else
							
							lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero

							for _, boat in ipairs(boats) do
								if not boat or not boat.Parent then continue end
								local titan = getTitan(boat.Collider)

								if not titan or not titan:FindFirstChild("HumanoidRootPart") then task.wait() continue end

								if (Vector3.new(boat.Collider.Position.X, 0, boat.Collider.Position.Z) - Vector3.new(titan.HumanoidRootPart.Position.X, 0, titan.HumanoidRootPart.Position.Z)).Magnitude <= 300 then
									teleportTo(titan.HumanoidRootPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
									hitTitan(titan)
								end
							end
						end
					elseif isFemaleRaid then 
						farmBoss()
					elseif isColossalRaid then

						local erenCollider = workspace.Unclimbable.Objective.Defend_Eren_2.Collider
						local titan = getTitan(erenCollider)

						if rsObjectiveFolder.Stall_Colossal_Titan.Value == 0 then
							if not cannon then task.wait() continue end

							if not workspace.Titans:FindFirstChild("Colossal_Titan") then 
								lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero 
								task.wait() 
								continue 
							end
							
							if not cannon:GetAttribute("Cooldown") and not usingCannon then
								usingCannon = true
								lp.Character.HumanoidRootPart.CFrame = cannon:GetPivot()
								getRemote:InvokeServer("Cannon", "State", cannon, true)
								getRemote:InvokeServer("Cannon", "Shoot", {["BarrelWood"] = 40, ["Base"] = 0})
								task.wait(1) 
								
								local projectile = workspace:FindFirstChild("Cannon")

								if projectile then
									for i = 1, 10 do -- multiply dmg
										postRemote:FireServer("S_Skills", "Impact", projectile, workspace.Titans.Colossal_Titan.Hitboxes.Hit.Nape.Position)
									end
								end

								task.wait(0.7)
								usingCannon = false
							else
								if titan and titan:FindFirstChild("HumanoidRootPart") and (titan.HumanoidRootPart.Position - erenCollider.Position).Magnitude <= 200 and not usingCannon then
									if (lp.Character.HumanoidRootPart.Position - cannon:GetPivot().Position).Magnitude < 10 then
										local hopOffArgs = {
											[1] = "Cannon",
											[2] = "State",
											[3] = cannon,
											[4] = false,
											[5] = {
												["SFX"] = {
													["Y"] = cannon.Base:FindFirstChild("Cannon_Y"),
													["X"] = cannon.Base:FindFirstChild("Cannon_X")
												},
												["Object"] = cannon,
												["BarrelWood"] = cannon.Barrel.BarrelWood,
												["Angles"] = {
													["BarrelWood"] = 0,
													["Base"] = 0
												},
												["Base"] = cannon.Base,
												["Directions"] = {}
											}
										}
										getRemote:InvokeServer(table.unpack(hopOffArgs))
									end
									
									teleportTo(titan.HumanoidRootPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
									task.spawn(function()
										hitTitan(titan)
									end)
								else
									lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
									task.wait()
								end
							end
						else
							local boss = getBoss()
							if not boss or not boss:FindFirstChild("HumanoidRootPart") then task.wait(); continue end
							teleportTo(boss.HumanoidRootPart, Vector3.new(0, 450, 0))
							task.spawn(function()
								if boss and boss:FindFirstChild("HumanoidRootPart") and boss:GetAttribute("State") ~= "Heatwave" then
									if isLastTitanLocked() then
										if titan and titan:FindFirstChild("HumanoidRootPart") and titan.Fake.Head.CanCollide then
											hitTitan(titan, false)
										else
											task.wait()
										end
										return
									end
									hitTitan(boss, true, erenCollider)
								elseif titan and titan:FindFirstChild("HumanoidRootPart") and titan.Fake.Head.CanCollide then
									hitTitan(titan, false)
								else
									lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
									task.wait()
								end
							end)
						end
					end
				task.wait()		
			end
		end)
		-- if not success then warn(err) end
	end)
end



local familyRaritiesOptions = {
	"Rare",
	"Epic",
	"Legendary",
	"Mythic"
}

local rarityOrder = { "Mythic", "Legendary", "Epic" }
local familyNamesList = {}
if families then
	for _, rarity in ipairs(rarityOrder) do
		local familiesInRarity = families[rarity]
		if familiesInRarity then
			local names = {}
			for name, _ in pairs(familiesInRarity) do
				table.insert(names, name)
			end
			table.sort(names)
			for _, name in ipairs(names) do
				table.insert(familyNamesList, name)
			end
		end
	end
end

