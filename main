						description = hasSpecial
							and "A rare item was obtained this run. Check the **Special Drops** field below."
							or "Run complete — reward summary attached below.",

						fields = {
							{
								name = "📋  Account",
								value = infoValue,
								inline = true
							},
							{
								name = "📊  Progression",
								value = statsValue,
								inline = true
							},
							{
								name = "⚔️  Combat",
								value = formatTable(data.Stats),
								inline = false
							},
							{
								name = "🎁  Rewards This Run",
								value = formatItems(data.Items),
								inline = true
							},
