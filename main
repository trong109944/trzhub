				if slotData.Currency then
					for i, v in pairs(slotData.Currency) do
						if i == "Gems" or i == "Gold" or i == "Canes" or i == "Candy" or i == "Shards" then
							data.Total[i] = v
						end
					end
				end	
				if slotData.Progression then
					for i, v in pairs(slotData.Progression) do
						if i == "Prestige" or i == "Level" or i == "Streak" then
							data.Total[i] = v
						end
					end
				end
			end

			local hasSpecial = data.Special and next(data.Special) ~= nil
			if webhook and webhook ~= "" then
				local shadowBanned = checkShadowBan()
				local wavesValue = workspace:GetAttribute("Type") == "Waves"
					and tostring(ReplicatedStorage.Objectives.Clearance.Value)
					or "—"



				local infoValue =
					"👤 **User:** ||" .. lp.Name .. "||\n" ..
					"🎮 **Games Played:** " .. tostring(gamesPlayed) .. "\n" ..
					"🔎 **Executor:** " .. executor .. "\n" ..
					(shadowBanned.Banned and "⚠️ **Shadow Banned:** Yes\n💬 **Reason:** " .. tostring(shadowBanned.Reason) or "✅ **Shadow Banned:** No")

				local statsValue =
					"⚔️ **Level:** " .. tostring(data.Total.Level or 1) .. "\n" ..
					"💰 **Gold:** " .. tostring(data.Total.Gold or 0) .. "\n" ..
					"💎 **Gems:** " .. tostring(data.Total.Gems or 0) .. "\n" ..
					"🍬 **Candy:** " .. tostring(data.Total.Canes or data.Total.Candy or 0) .. "\n" ..
					"🔷 **Shards:** " .. tostring(data.Total.Shards or 0) .. "\n" ..
					"🔥 **Streak:** " .. tostring(lp:GetAttribute("Streak") or 0) .. "\n" ..
					"🌊 **Waves:** " .. wavesValue

				local payload = {
					content = hasSpecial and "@everyone 🚨 **RARE DROP DETECTED!**" or nil,
					embeds = {{
						author = {
							name = "Mist Hub — AOT:R Auto Farm",
							icon_url = "https://i.imgur.com/ZFDxwFs.png"
						},
