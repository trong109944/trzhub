-- FamilyRollGroup: Family Rolling Options
FamilyRollGroup:AddToggle("AutoRollToggle", {
	Text = "Auto Roll Family",
	Default = false,
	Tooltip = "Automatically rolls for selected families/rarities (Mythicals stop automatically)"
})
Toggles.AutoRollToggle:OnChanged(function(Value)
	getgenv().AutoRoll = Value
	if getgenv().AutoRoll then
		if game.PlaceId ~= 13379208636 then
			Library:Notify({
				Title = "Mist Hub",
				Description = "You must be in the main menu to use family roll features.",
				Time = 3
			})
			return
		end
		task.spawn(function()
			while getgenv().AutoRoll do
				local targets, rarities

				local selectedFamilies = Options.SelectFamilyList.Value
				if selectedFamilies then
					targets = {}
					for familyName, isEnabled in pairs(selectedFamilies) do
						if isEnabled then
							table.insert(targets, string.lower(familyName))
						end
					end
				end

				local raritySelected = Options.SelectFamilyRarity.Value
				if raritySelected then
					rarities = {}
					for rarityName, isEnabled in pairs(raritySelected) do
						if isEnabled then
							table.insert(rarities, string.lower(rarityName))
						end
					end
				end
				
				roll(targets, rarities)
				task.wait(0.05)
			end
		end)
	end
end)

