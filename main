				task.spawn(function()
					pcall(function()
						request({
							Url = webhook,
							Method = "POST",
							Headers = { ["Content-Type"] = "application/json" },
							Body = HttpService:JSONEncode(payload)
						})
					end)
				end)
			end
		end
		
		uploadStats()
			
		if willReturn then
			task.wait(0.5)
			returnToLobby()
			return
		end
	end)
end

