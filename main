SettingsGroup:AddToggle("SyncConfigToggle", {
	Text = "Sync Config Across Accounts",
	Default = syncConfigEnabled,
	Tooltip = "Uses a shared configuration directory for all accounts instead of per-account folders"
})
Toggles.SyncConfigToggle:OnChanged(function(Value)
	if Value == syncConfigEnabled then return end
	syncConfigEnabled = Value
	-- External config controls this state; no config file is written.

	-- Update path variables
	configIdentifier = syncConfigEnabled and "shared" or lp.Name
	ConfigFile = "./MistHub/aotr/dropdown_config_" .. configIdentifier .. ".json"
	returnCounterPath = "./MistHub/aotr/return_lobby_counter_" .. configIdentifier .. ".txt"
	path = "./MistHub/aotr/games_played" .. configIdentifier .. ".txt"

	-- Reload dropdown configurations
	if not isfile(returnCounterPath) then writefile(returnCounterPath, "0") end
	if not isfile(path) then writefile(path, "0") end
	gamesPlayed = tonumber(readfile(path)) or 0
	gamesUntilReturn = tonumber(readfile(returnCounterPath)) or 0
	DropdownConfig = LoadConfig()

	-- Apply loaded DropdownConfig to dropdown controls
	local savedType = DropdownConfig._lastType or "Missions"
	Options.StartTypeDropdown:SetValue(savedType)
	
	local savedMap = DropdownConfig[savedType] and DropdownConfig[savedType].map
	if savedMap then Options.StartMapDropdown:SetValue(savedMap) end
	
	local savedObj = DropdownConfig[savedType] and DropdownConfig[savedType].objective
	if savedObj then Options.StartObjectiveDropdown:SetValue(savedObj) end
	
	local savedDiff = DropdownConfig[savedType] and DropdownConfig[savedType].difficulty
	if savedDiff then Options.StartDifficultyDropdown:SetValue(savedDiff) end

	-- Theme/config UI files are kept at the shared MistHub/aotr root.
	ThemeManager:SetFolder("MistHub/aotr")
	SaveManager:SetFolder("MistHub/aotr")

	Library:Notify({
		Title = "Sync Configuration",
		Description = "Configuration sync state updated successfully.",
		Time = 3
	})
end)

