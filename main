local getBladeCount = LPH_JIT_MAX(function()
	if not Interface:FindFirstChild("HUD") then return end
	local text = PlayerGui.Interface.HUD.Main.Top[7].Blades.Sets.Text
	return tonumber(text:match("(%d+)%s*/"))
end)
local function handleWeaponReload()
	if not autoReloadEnabled then return end
	if isReloading then return end
	if os.clock() - lastReloadTime < getgenv().AutoFarmConfig.ReloadCD then return end

	local weapon = lp:GetAttribute("Weapon")

	local refillPart
	if workspace:FindFirstChild("Unclimbable") or (workspace:FindFirstChild("Climbable") and workspace.Climbable:FindFirstChildOfClass("Utgard")) then
		if workspace.Climbable:FindFirstChildOfClass("Utgard") then
			for _, v in ipairs(workspace.Climbable.Utgard:GetDescendants()) do
				if v.Name == "Refill" and v:IsA("BasePart") then
					refillPart = v
					break
				end
			end
		elseif workspace:FindFirstChild("Unclimbable") then
			for _, v in ipairs(workspace.Unclimbable:GetDescendants()) do
				if v.Name == "Refill" and v:IsA("BasePart") then
					refillPart = v
					break
				end
			end
		end
	end

	if weapon == "Blades" then

		local char = lp.Character
		local rig = char and char:FindFirstChild("Rig_" .. lp.Name)
		local blade = rig and rig:FindFirstChild("LeftHand") and rig.LeftHand:FindFirstChild("Blade_1")

		local ammo = getBladeCount() or 0

		if ammo == 0 and autoRefillEnabled and blade and blade.Transparency == 1 then
			if refillPart then
				isReloading = true
				lastReloadTime = os.clock()

				while getBladeCount() == 0 do
					getRemote:InvokeServer("Attacks", "Reload", refillPart)
					task.wait(0.2)
				end

				isReloading = false
			end
			return
		end


		if blade and blade.Transparency == 1 and ammo > 0 then
			
			isReloading = true
			lastReloadTime = os.clock()
			
			while blade.Transparency ~= 0 do
				getRemote:InvokeServer("Blades", "Reload")
				task.wait(0.5)
			end

			isReloading = false
			return
		end
	else
		
		local HUD = Interface:FindFirstChild("HUD")
		if not HUD then return end

		local ammo, maxAmmo = string.match(HUD.Main.Top[7].Spears.Spears.Text, "(%d+)%s*/%s*(%d+)")
		ammo = tonumber(ammo)
		maxAmmo = tonumber(maxAmmo)

		if ammo == 0 and autoRefillEnabled and not getgenv().InfSpearsAmmo then

			if refillPart then
				isReloading = true
				lastReloadTime = os.clock()

				repeat
					postRemote:FireServer("Attacks", "Reload", refillPart)
					task.wait(0.2)
					ammo = tonumber(HUD.Main.Top[7].Spears.Spears.Text:match("(%d+)%s*/"))
				until ammo > 0 or (os.clock() - lastReloadTime >= 0.5)

				isReloading = false
			end
		end
	end
end
task.spawn(function()
	while true do
		local success, err = pcall(function()
			handleWeaponReload()
		end)
		-- if not success then warn(err) end
		task.wait(0.5)
	end
end)

