local function autoEquipPerks()
	if game.PlaceId ~= 14916516914 then return end
	local equippedThisSession = {}
	task.spawn(function()
		while getgenv().AutoEquipPerks do
			local plrData = GetPlayerData()
			if plrData and plrData.Slots then
				local slotIndex = lp:GetAttribute("Slot")
				local slot = slotIndex and plrData.Slots[slotIndex]
				if slot and slot.Perks then
					local slotSelections = {
						Offense = Options.OffensePerksDropdown.Value or {},
						Defense = Options.DefensePerksDropdown.Value or {},
						Support = Options.SupportPerksDropdown.Value or {},
						Body = Options.BodyPerksDropdown.Value or {},
						Family = Options.FamilyPerksDropdown.Value or {},
					}
					
					local bestPerSlot = {}
					for ptype, selection in pairs(slotSelections) do
						local selectedSet = {}
						for name, isActive in pairs(selection) do
							if isActive then selectedSet[name] = true end
						end
						
						local best = nil
						for id, perkData in pairs(slot.Perks.Storage or {}) do
							local name = perkData.Name
							if name and selectedSet[name] then
								local rarity = GetPerkRarity(name)
								local prio = PerkRarityPriority[rarity] or 0
								local lvl = perkData.Level or 0
								if (not best) or (prio > best.prio) or (prio == best.prio and lvl > best.lvl) then
									best = { id = id, prio = prio, lvl = lvl, name = name }
								end
							end
						end
						if best then bestPerSlot[ptype] = best end
					end
					
					for ptype, info in pairs(bestPerSlot) do
						local equippedId = slot.Perks.Equipped and slot.Perks.Equipped[ptype]
						if equippedId ~= info.id and not equippedThisSession[info.id] then
							local success = getRemote:InvokeServer("S_Equipment", "Perk_State", info.id, "Equip", ptype)
							if success then
								equippedThisSession[info.id] = true
								Library:Notify({
									Title = "Auto Equip Perks",
									Description = "Equipped " .. info.name .. " to " .. ptype,
									Time = 2
								})
							else
								getRemote:InvokeServer("S_Equipment", "Perk_State", info.id, "Equip", "Body")
								equippedThisSession[info.id] = true
								Library:Notify({
									Title = "Auto Equip Perks",
									Description = "Equipped " .. info.name .. " to Body",
									Time = 2
								})
							end
							task.wait(0.5)
						end
					end
				end
			end
			task.wait(2)
		end
	end)
end

Toggles.AutoEquipPerksToggle:OnChanged(function(Value)
	getgenv().AutoEquipPerks = Value
	if Value then autoEquipPerks() end
end)

