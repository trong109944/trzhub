-- ============================================================================
-- Apply getgenv().MistHub_Config
-- Options are applied first so toggle callbacks can safely use their values.
-- Missing/unknown keys are ignored, making the config forward-compatible.
-- ============================================================================
local function ApplyMistHubConfig()
	-- Options first.
	for name, value in pairs(MistHubOptionConfig) do
		local option = Options[name]
		if option and option.SetValue then
			pcall(function()
				option:SetValue(value)
			end)
		end
	end

	-- Apply toggles that only change state first.
	local delayedToggles = {
		AutoStartToggle = true,
		AutoFarm = true,
		AutoFarmRaids = true,
		AutoFarmWaves = true,
		AutoRetryToggle = true,
		RjUntilErenSkin = true,
		RjUntilAnnieSkin = true,
	}

	for name, value in pairs(MistHubToggleConfig) do
		if not delayedToggles[name] then
			local toggle = Toggles[name]
			if toggle and toggle.SetValue then
				pcall(function()
					toggle:SetValue(value)
				end)
			end
		end
	end

	-- Start/automation toggles last, after every other setting is ready.
	for _, name in ipairs({
		"RjUntilErenSkin",
		"RjUntilAnnieSkin",
		"AutoFarmWaves",
		"AutoFarmRaids",
		"AutoRetryToggle",
		"AutoFarm",
		"AutoStartToggle",
	}) do
		if MistHubToggleConfig[name] ~= nil then
			local toggle = Toggles[name]
			if toggle and toggle.SetValue then
				pcall(function()
					toggle:SetValue(MistHubToggleConfig[name])
				end)
			end
		end
	end
end

task.defer(function()
	ApplyMistHubConfig()
end)

if Library.OnUnload then
	Library:OnUnload(function()
		Library.Unloaded = true
	end)
else
	local originalUnload = Library.Unload
	function Library:Unload()
		Library.Unloaded = true
		if originalUnload then
			originalUnload(self)
		end
	end
end

-- auto hide
task.spawn(function()
	task.wait(0.5) -- wait for config load
	if Toggles.FPSCapToggle and Toggles.FPSCapToggle.Value and setfpscap then
		setfpscap(Options.FPSCapSlider.Value)
	end
	if Toggles.AutoHideToggle.Value then
		if Library.HideGui then
			Library:HideGui(false)
		elseif Library.HideUI then
			Library:HideUI(false)
		elseif Library.Toggle then
			Library:Toggle(false)
		end
		Library:Notify({
			Title = "Mist Hub",
			Description = "Hid GUI on Load",
			Time = 2
		})
	end
end)

task.spawn(function()
	task.wait(2)
	uploadStats()
end)

if isMap then
	task.spawn(function()
		while task.wait(1) do
			if getgenv().SoloOnly and #Players:GetPlayers() > 1 then
				returnToLobby()
				break
			end
			if getgenv().Failsafe and Options and Options.FailsafeTimeSlider and workspace.DistributedGameTime >= Options.FailsafeTimeSlider.Value * 60 then
				returnToLobby()
				break
			end
		end
	end)
end

