local function checkShadowBan()
	local plrData = GetPlayerData()
	if not plrData then
		repeat
			plrData = GetPlayerData()
		until plrData
	end

	if plrData.Disabled then
		return {Banned = true, Reason = plrData.Disabled}
	end

	return {Banned = false, Reason = ""}
end

local function returnToLobby()
	if identifyexecutor() == "Delta" then
		getRemote:InvokeServer("Functions", "Teleport", "Lobby")
	else
		TeleportService:Teleport(14916516914, lp)
	end
end

local function rjUntilFemaleSkin()
	if isLobby then
		Options.StartTypeDropdown:SetValue("Raids")
		Options.StartMapDropdown:SetValue("Stohess")
		Options.StartObjectiveDropdown:SetValue("Female Titan")
		Options.StartDifficultyDropdown:SetValue("Hardest")
		Toggles.AutoStartToggle:SetValue(true)
	elseif isMap and isFemaleRaid then
		repeat task.wait() until workspace:GetAttribute("Finalised")
		local femaleTitan = workspace.Titans:WaitForChild("Female_Titan")
		if not femaleTitan:GetAttribute("Skin") then
			returnToLobby()
		end
	end
end

