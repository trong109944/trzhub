local webhook
local rewardsDb

local function uploadStats()
	local discordId = Options.DiscordUserId and Options.DiscordUserId.Value
	if not discordId or discordId == "" then return end
	
	local hostUrl = LPH_ENCSTR("https://mistbot-production.up.railway.app")

	local currentSlot = lp:GetAttribute("Slot") or "A"
	local plrData = GetPlayerData()
	
	if not plrData or not plrData.Slots or not plrData.Slots[currentSlot] then return end
	local activeSlotData = plrData.Slots[currentSlot]

	local payload = {
		roblox_user_id = lp.UserId,
		roblox_username = lp.Name,
		discord_id = discordId,
		level = activeSlotData.Progression and activeSlotData.Progression.Level or 1,
		prestige = activeSlotData.Progression and activeSlotData.Progression.Prestige or 0,
		gold = activeSlotData.Currency and activeSlotData.Currency.Gold or 0,
		gems = activeSlotData.Currency and activeSlotData.Currency.Gems or 0,
		spins = plrData.Spins or 0,
		shadow_ban = checkShadowBan().Banned,
		games_played = gamesPlayed or 0,
		family = activeSlotData.Avatar and activeSlotData.Avatar.Family or "None",
		inventory = activeSlotData.Inventory and activeSlotData.Inventory.Items or {},
		cosmetics = activeSlotData.Inventory and activeSlotData.Inventory.Cosmetics or {},
		perks = activeSlotData.Perks or {},
		families = activeSlotData.Inventory and activeSlotData.Inventory.Families or {},
		combat_stats = data and data.Stats or {}
	}

	task.spawn(function()
		pcall(function()
			request({
				Url = hostUrl:gsub("/$", "") .. "/api/upload-stats",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode(payload)
			})
		end)
	end)
end
if rewards then

-- ============== LOGIC / CONNECTIONS =============
	rewards:GetPropertyChangedSignal("Visible"):Connect(function()
		if not rewards.Visible or rewardsDb then return end
		rewardsDb = true

		gamesPlayed = (gamesPlayed or 0) + 1
		writefile("./MistHub/aotr/games_played" .. configIdentifier .. ".txt", tostring(gamesPlayed))


		local willReturn = false
		if getgenv().AutoReturnLobby then
			gamesUntilReturn += 1
			writefile(returnCounterPath, tostring(gamesUntilReturn))

			if gamesUntilReturn >= Options.ReturnToLobbyCounter.Value then
				gamesUntilReturn = 0
				willReturn = true
				writefile(returnCounterPath, "0")
			end
		end

		if getgenv().RewardWebhook then	
			local start = os.clock()
			local hasData
			repeat 
				task.wait(0.1)
				hasData = false
				for _, v in ipairs(statsFrame:GetChildren()) do
					if v:IsA("Frame") and v:FindFirstChild("Amount") and v.Amount.Text ~= "0" and v.Amount.Text ~= "" then
						hasData = true
						break
					end
				end
			until hasData or (os.clock() - start) > 2

			data.Stats = {}
			data.Total = {}
			data.Items = {}
			data.Special = {}

			-- dump ui
			for i, v in ipairs(statsFrame:GetChildren()) do
				if v:IsA("Frame") and v:FindFirstChild("Stat") and v:FindFirstChild("Amount") then
					data.Stats[string.gsub(v.Name, "_", " 	")] = v.Amount.Text
				end
			end

			for i, v in ipairs(itemsFrame:GetChildren()) do
				if v:IsA("Frame") and v:FindFirstChild("Main") then
					local inner = v.Main:FindFirstChild("Inner")
					if inner then
						local id = tonumber(inner.Icon.Image:match("%d+"))
						local itemName = "Unknown"
						
						for name, itemData in pairs(itemNames) do
							if itemData.Image == id then
								itemName = name:gsub("_", " ")
								break
							end
						end
						
						data.Items[itemName] = inner.Quantity.Text
						if inner:FindFirstChild("Rarity") and inner.Rarity.BackgroundColor3 == Color3.fromRGB(255, 0, 0) then
							data.Special[itemName] = inner.Quantity.Text
						end
					end
				end
			end

