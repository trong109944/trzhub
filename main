local function autoSellPerks()
	if game.PlaceId ~= 14916516914 then return end
	task.spawn(function()
		while getgenv().AutoSellPerks do
			local plrData = GetPlayerData()
			if plrData and plrData.Slots then
				local slotIndex = lp:GetAttribute("Slot")
				local slot = slotIndex and plrData.Slots[slotIndex]
				if slot and slot.Perks then
					local selected = Options.AutoSellPerksDropdown.Value or {}
					local raritySet = {}
					for r, isActive in pairs(selected) do
						if isActive and r ~= "Mythic" then raritySet[r] = true end
					end

					local equippedSet = {}
					for _, id in pairs(slot.Perks.Equipped or {}) do
						if id and id ~= "" then equippedSet[id] = true end
					end

					local keepNames = {}
					local dropList = {
						Options.OffensePerksDropdown, Options.DefensePerksDropdown,
						Options.SupportPerksDropdown, Options.BodyPerksDropdown,
						Options.FamilyPerksDropdown
					}
					for _, drop in ipairs(dropList) do
						if drop and drop.Value then
							for name, isActive in pairs(drop.Value) do
								if isActive then keepNames[name] = true end
							end
						end
					end

					local toSell = {}
					for id, perkData in pairs(slot.Perks.Storage or {}) do
						if not equippedSet[id] and not keepNames[perkData.Name] then
							local rarity = GetPerkRarity(perkData.Name)
							if rarity and raritySet[rarity] then
								table.insert(toSell, id)
								if #toSell >= 50 then break end
							end
						end
					end

					if #toSell > 0 then
						getRemote:InvokeServer("S_Equipment", "Delete", "Perk", toSell)
						Library:Notify({
							Title = "Auto Sell Perks",
							Description = "Sold " .. #toSell .. " perk(s)",
							Time = 2
						})
					end
				end
			end
			task.wait(3)
		end
	end)
end

Toggles.AutoSellPerksToggle:OnChanged(function(Value)
	getgenv().AutoSellPerks = Value
	if Value then autoSellPerks() end
end)

