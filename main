local function LoadConfig()
	if not isfile(ConfigFile) then
		return { Missions = {}, Raids = {}}
	end
	local success, config = pcall(HttpService.JSONDecode, HttpService, readfile(ConfigFile))
	return success and config or { Missions = {}, Raids = {}}
end

