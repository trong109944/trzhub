local Perk_Level_XP = {
	Common    = {50, 100, 150, 200, 250, 300, 350, 400, 450, 500},
	Rare      = {125, 250, 375, 500, 625, 750, 875, 1000, 1125, 1250},
	Epic      = {250, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500},
	Legendary = {500, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500, 5000},
	Secret    = {2000, 4000, 6000, 8000, 10000, 12000, 14000, 16000, 18000, 20000},
}

local Perk_Base_XP = {
	Common    = 100,
	Rare      = 250,
	Epic      = 625,
	Legendary = 2500,
	Secret    = 10000,
}

local Skills = (isLobby and require(ReplicatedStorage.Modules.Storage.Skills)) or nil

local Index = {
	Blades = { Trunk = {}, Critical = {}, Damage = {} },
	Spears = { Trunk = {}, Critical = {}, Damage = {} },
	Defense = { Trunk = {}, Health = {}, ["Damage Reduction"] = {} },
	Support = { Trunk = {}, Regen = {}, ["Cooldown Reduction"] = {} }
}

if isLobby then
	for id, s in pairs(Skills) do
		if s.Free or s.Families then continue end

		if s.Type == "Offense" then
			if s.Weapon == "Blades" then
				if not s.Path then table.insert(Index.Blades.Trunk, id)
				elseif s.Path == "14" then table.insert(Index.Blades.Critical, id)
				elseif s.Path == "26" then table.insert(Index.Blades.Damage, id)
				end
			elseif s.Weapon == "Spears" then
				if not s.Path then table.insert(Index.Spears.Trunk, id)
				elseif s.Path == "126" then table.insert(Index.Spears.Critical, id)
				elseif s.Path == "138" then table.insert(Index.Spears.Damage, id)
				end
			end
		elseif s.Type == "Defense" then
			if not s.Path then table.insert(Index.Defense.Trunk, id)
			elseif s.Path == "46" then table.insert(Index.Defense.Health, id)
			elseif s.Path == "58" then table.insert(Index.Defense["Damage Reduction"], id)
			end
		elseif s.Type == "Support" then
			if not s.Path then table.insert(Index.Support.Trunk, id)
			elseif s.Path == "81" then table.insert(Index.Support.Regen, id)
			elseif s.Path == "90" then table.insert(Index.Support["Cooldown Reduction"], id)
			end
		end
	end
end
