-- SlotGroup: Slots & Prestige
SlotGroup:AddToggle("AutoSelectSlot", {
	Text = "Auto Load Slot",
	Default = false,
	Tooltip = "Loads the chosen character slot automatically when joining"
})
Toggles.AutoSelectSlot:OnChanged(function(Value)
	getgenv().AutoSlot = Value
	if getgenv().AutoSlot and isMainMenu then
		task.spawn(function()
			task.wait(1) -- wait for config to load
			if not getgenv().AutoSlot then return end

			if not lp:GetAttribute("Slot") then
				local selectedSlot = Options.SelectSlotDropdown.Value or "Slot A"
				local args = { "Functions", "Select", string.sub(selectedSlot, -1) }
				repeat
					getRemote:InvokeServer(unpack(args))
					task.wait(1)
				until lp:GetAttribute("Slot") or not getgenv().AutoSlot
			end

			if lp:GetAttribute("Slot") and getgenv().AutoSlot then
				returnToLobby()
			end
		end)
	end
end)

SlotGroup:AddDropdown("SelectSlotDropdown", {
