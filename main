	Multi = false,
	Text = "Slot Selection",
})

SlotGroup:AddToggle("AutoPrestigeToggle", {
	Text = "Auto Prestige",
	Default = false,
	Tooltip = "Automatically prestiges when level and gold requirements are met"
})
Toggles.AutoPrestigeToggle:OnChanged(function(Value)
	getgenv().AutoPrestige = Value
	if getgenv().AutoPrestige then
		if game.PlaceId ~= 14916516914 then return end
		task.spawn(function()
			while getgenv().AutoPrestige do
				local pData = GetPlayerData()
				if not pData or not pData.Slots then 
					task.wait(1) 
					continue 
				end
				local slotIdx = lp:GetAttribute("Slot")
				if not slotIdx or not pData.Slots[slotIdx] then 
					task.wait(1) 
					continue 
				end
				local gold = pData.Slots[slotIdx].Currency.Gold
				local prestige = pData.Slots[slotIdx].Progression.Prestige or 0
				local level = pData.Slots[slotIdx].Progression.Level or 1

				if prestige >= 5 then
					Library:Notify({
						Title = "Auto Prestige",
						Description = "Already at maximum Prestige (Prestige 5)",
						Time = 5
					})
					getgenv().AutoPrestige = false
					Toggles.AutoPrestigeToggle:SetValue(false)
					break
				end

				local requiredGold
				if Toggles.AutoPrestigeMaxGoldToggle and Toggles.AutoPrestigeMaxGoldToggle.Value then
					requiredGold = (prestige * 200000000) + 200000000
				elseif Toggles.GoldPerPrestigeToggle and Toggles.GoldPerPrestigeToggle.Value then
					if prestige == 0 then
						requiredGold = Options.PrestigeOneGoldSlider.Value * 1000000
					elseif prestige == 1 then
						requiredGold = Options.PrestigeTwoGoldSlider.Value * 1000000
					elseif prestige == 2 then
						requiredGold = Options.PrestigeThreeGoldSlider.Value * 1000000
					elseif prestige == 3 then
						requiredGold = Options.PrestigeFourGoldSlider.Value * 1000000
					elseif prestige == 4 then
						requiredGold = Options.PrestigeFiveGoldSlider.Value * 1000000
					else
						requiredGold = 0
					end
				else
					requiredGold = Options.PrestigeGoldSlider.Value * 1000000
				end

				if gold >= requiredGold and level >= (prestige * 25 + 100) then
					for _, Memory in ipairs(Talents) do
						if not getgenv().AutoPrestige then break end
						getRemote:InvokeServer("S_Equipment", "Talents")
						local success = getRemote:InvokeServer("S_Equipment", "Prestige", {Boosts = Options.SelectBoostDropdown.Value, Talents = Memory})
						if success then
							Library:Notify({
								Title = "Successfully Prestiged",
								Description = "Prestiged with " .. Options.SelectBoostDropdown.Value .. " and " .. Memory,
								Time = 5
							})
							getgenv().AutoPrestige = false
							Toggles.AutoPrestigeToggle:SetValue(false)
							break
						end
						task.wait()
					end
				end
				task.wait(5)
			end
		end)
	end
end)

