end

local function dieAtStreak()
	task.spawn(function()
		while getgenv().DieAtStreak do
			local streak = lp:GetAttribute("Streak")
			if getgenv().DieAtStreak and streak and streak >= Options.DieAtStreakSlider.Value then
				lp:SetAttribute("Cutscene", true) -- to stop auto farm
				lp.Character.Humanoid.Health = 0
				return
			end
			task.wait(1)
		end
	end)
end

local function autoRetry()
	if not isMap then
		return
	end

	task.spawn(function()
		while getgenv().AutoRetry do

			if rewards and rewards.Visible then
				local Buttons = rewards.Main.Info.Main.Buttons
				local retryButton = Buttons and Buttons:FindFirstChild("Retry")
				local retryButtonTitle = retryButton and retryButton:FindFirstChild("Title")

				if Buttons and Buttons.Visible
					and retryButton
					and retryButton.Visible
					and retryButton.Active
					and retryButtonTitle
					and not string.find(retryButtonTitle.Text, "(0/0)")
					and not string.find(retryButtonTitle.Text, "STARTING") then
					task.wait(1)
					UseButton(retryButton)
				end
			end
			task.wait(1)
		end
	end)
end

local function autoSkillTree()
	if game.PlaceId ~= 14916516914 then return end
	
	task.spawn(function()	
		while getgenv().AutoSkillTree do
			local plrData = GetPlayerData()
			
			local slotIndex = lp:GetAttribute("Slot")
			if not plrData or not slotIndex or not plrData.Slots[slotIndex] then task.wait(1) continue end
			local weapon = plrData.Slots[slotIndex].Weapon

			local middle = Options.MiddlePathDropdown.Value
			local left = Options.LeftPathDropdown.Value
			local right = Options.RightPathDropdown.Value

			local middleTrunk = SkillPaths[weapon] and SkillPaths[weapon].Trunk
			local leftTrunk = SkillPaths.Support and SkillPaths.Support.Trunk
			local rightTrunk = SkillPaths.Defense and SkillPaths.Defense.Trunk

			local middlePath = SkillPaths[weapon] and SkillPaths[weapon][middle]
			local leftPath = SkillPaths.Support and SkillPaths.Support[left]
			local rightPath = SkillPaths.Defense and SkillPaths.Defense[right]

			local p1 = Options.Priority1Dropdown.Value or "Middle"
			local p2 = Options.Priority2Dropdown.Value or "Left"
			local p3 = Options.Priority3Dropdown.Value or "None"

			local pathMap = { 
				Left = { leftTrunk, leftPath }, 
				Middle = { middleTrunk, middlePath }, 
				Right = { rightTrunk, rightPath } 
			}
			local paths = {}
			local used = {}

			local function addPath(p)
				if not used[p] and pathMap[p] then
					if pathMap[p][1] then table.insert(paths, pathMap[p][1]) end
					if pathMap[p][2] then table.insert(paths, pathMap[p][2]) end
					used[p] = true
				end
			end

			addPath(p1)
			addPath(p2)
			addPath(p3)

			for _, path in ipairs(paths) do
				if path then
					for _, skillId in ipairs(path) do
						if table.find(plrData.Slots[slotIndex].Skills.Unlocked, skillId) then continue end
						local success = getRemote:InvokeServer("S_Equipment", "Unlock", {skillId})
						if success then
							table.insert(plrData.Slots[slotIndex].Skills.Unlocked, skillId)
							Library:Notify({
								Title = "Unlocked Skill",
								Description = "ID: " .. skillId,
								Time = 1
							})
						end
					end
				end
			end
			task.wait()
		end
	end)
end

local function autoEnhancePerk()
	if not getgenv().AutoPerk then return end
	if game.PlaceId ~= 14916516914 then return end
	task.spawn(function()
		local plrData
		local slotIndex
		while getgenv().AutoPerk do
			plrData = GetPlayerData()
			slotIndex = lp:GetAttribute("Slot")
			if plrData and plrData.Slots and slotIndex and plrData.Slots[slotIndex] then
				break
			end
			task.wait(1)
		end
		
		if not getgenv().AutoPerk then return end

		local slot = plrData.Slots[slotIndex]
		local storagePerks = {}
		for id, val in pairs(slot.Perks.Storage) do storagePerks[id] = val end

		local perkSlot = Options.PerkSlotDropdown.Value
		local equippedPerkId = slot.Perks.Equipped[perkSlot]
		if not equippedPerkId then
			Library:Notify({ Title = "Auto Perk", Description = "No perk equipped in " .. tostring(perkSlot) .. " slot.", Time = 3 })
			getgenv().AutoPerk = false
			Toggles.AutoEnhanceToggle:SetValue(false)
			return
		end

		local perkData = storagePerks[equippedPerkId]
		if not perkData then
			Library:Notify({ Title = "Auto Perk", Description = "Equipped perk data not found.", Time = 3 })
			getgenv().AutoPerk = false
			Toggles.AutoEnhanceToggle:SetValue(false)
			return
		end

		local perkName = perkData.Name
		local rarity = GetPerkRarity(perkName)
		local currentLevel = perkData.Level or 0
		local currentXP = perkData.XP or 0

		while getgenv().AutoPerk do
			if currentLevel >= 10 then
				Library:Notify({ Title = "Auto Perk", Description = perkName .. " is already Level 10!", Time = 3 })
				break
			end

			local selectedRarities = Options.SelectPerksDropdown.Value
			local rarityPerks = {}
			if selectedRarities then
				for r, isActive in pairs(selectedRarities) do
					if isActive then rarityPerks[r] = true end
				end
			end

			local validPerks = {}
			local totalXPGain = 0

			for perkId, tbl in pairs(storagePerks) do
				local r = GetPerkRarity(tbl.Name)
				if perkId ~= equippedPerkId and rarityPerks[r] then
					table.insert(validPerks, perkId)
					totalXPGain = totalXPGain + GetPerkXP(r, math.max(tbl.Level or 0, 1))
					if #validPerks >= 20 then break end
				end
			end

			if #validPerks == 0 then
				Library:Notify({ Title = "Auto Perk", Description = "No more food perks found.", Time = 3 })
				break
			end

			if getRemote:InvokeServer("S_Equipment", "Enhance", equippedPerkId, validPerks) then
				for _, id in ipairs(validPerks) do storagePerks[id] = nil end

				currentXP = currentXP + totalXPGain

				while currentLevel < 10 do
					local thresholds = Perk_Level_XP[rarity]
					if not thresholds then break end
					local needed = thresholds[currentLevel + 1]
					if not needed or currentXP < needed then break end
					currentXP = currentXP - needed
					currentLevel = currentLevel + 1
				end

				Library:Notify({
					Title = "Enhanced: " .. perkName,
					Description = "Level " .. tostring(currentLevel) .. " (+" .. totalXPGain .. " XP)",
					Time = 1
				})
			else
				continue
			end

			task.wait(0.5)
		end

		getgenv().AutoPerk = false
		Toggles.AutoEnhanceToggle:SetValue(false)	
	end)
	end

local function autoExecute()
	if getgenv().AutoExecute and not getgenv().AutoExec then
		getgenv().AutoExec = true
		queue_on_teleport([[
			repeat task.wait() until game:IsLoaded()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/xytuu/MistHub/refs/heads/main/aotr", true))()
		]])
	end
end

local function autoUpgrade()
	if not isLobby then return end
	task.spawn(function()
		while getgenv().AutoUpgrade do
			local plrData = GetPlayerData()
			if not plrData or not plrData.Slots then task.wait(1) continue end
			
			local slotIndex = lp:GetAttribute("Slot")
			if not slotIndex or not plrData.Slots[slotIndex] then task.wait(1) continue end
			
			local weapon = plrData.Slots[slotIndex].Weapon
			local success = getRemote:InvokeServer("S_Equipment", "Upgrade", upgradesTable[weapon])
			
			if success then
				Library:Notify({ Title = "Upgraded: " .. weapon, Description = "Successfully upgraded", Time = 2 })
			end
			task.wait(1)
		end
	end)
end

local function collectSupplies()
	if getgenv().CollectingSupplies or not isMap then return end
	getgenv().CollectingSupplies = true

	task.spawn(function()
		lp:SetAttribute("Cutscene", true)
		for _, v in ipairs(workspace.Unclimbable:GetChildren()) do
			if string.find(v.Name, "ThunderSpear_Supplies") then
				lp.Character:PivotTo(v:GetPivot())
				task.wait(1)
				lp.Character:PivotTo(workspace.Unclimbable.Supplies_Circle:GetPivot() + Vector3.new(0, 50, 0))
				task.wait(1)
			end
		end
		lp:SetAttribute("Cutscene", nil)
	end)
end


local function skipCutscene()
	if not isMap then return end
	task.spawn(function()
		while getgenv().AutoSkip do
			local skip = Interface:FindFirstChild("Skip")
			if skip and skip.Visible then task.wait(3) end
			
			if skip and skip.Visible then
				if workspace:GetAttribute("Type") == "Missions" and workspace:GetAttribute("Objective") == "Breach" then
					for _, v in ipairs(workspace.Unclimbable.Cutscene:GetChildren()) do
						local count = 0
						local success = postRemote:FireServer("Functions", "Finished", v)
						repeat 
							postRemote:FireServer("Functions", "Finished", v)
							count += 1
						until success or count >= 3
						task.wait(0.25)	
					end
				end
				UseButton(skip.Interact)
			end
			task.wait()
		end
	end)
end

local function autoVote()
	if not isMap then return end
	task.spawn(function()
		while getgenv().AutoVote do
			local waves = Interface:FindFirstChild("Waves")
			if waves and waves.Inner.Visible and not lp:GetAttribute("Cutscene") then 
				UseButton(waves.Inner.Main.Vote)
			end
			
			task.wait(1)
		end
	end)
end

local function openChests()
	if not isMap then return end
			
	task.spawn(function()
		while getgenv().AutoChest do
			local chests = Interface:FindFirstChild("Chests")
			if chests and chests.Visible then
				local free = chests:FindFirstChild("Free")
				local premium = chests:FindFirstChild("Premium")
				local finish = chests:FindFirstChild("Finish")

				if free and free.Visible then
					repeat
						UseButton(free)
						task.wait(0.5)
					until not free or not free.Visible
				end

				if premium then
					repeat task.wait() until premium.Visible
				end

				if premium and premium.Visible and getgenv().OpenEmperorChest then
					local now = os.clock()
					repeat
						UseButton(premium)
						task.wait(0.2)
					until not premium or not premium.Visible or (os.clock() - now) >= 1
				end

				if finish then repeat task.wait() until finish.Visible end

				if finish and finish.Visible then
					repeat
						UseButton(finish)
						task.wait(0.5)
					until not chests.Visible
				end

			end
			task.wait(0.5)
		end
	end)
end

local function roll(targets, rarities)
	local plrData = GetPlayerData()
	if not plrData or not plrData.Slots then return end
	local slotIdx = lp:GetAttribute("Slot")
	if not slotIdx or not plrData.Slots[slotIdx] then return end
	local familyName = plrData.Slots[slotIdx].Avatar["Family"]
	local familyNameLower = string.lower(familyName)

	local familyRarity = nil
	if families then
		for rarity, familiesTbl in pairs(families) do
			for name, _ in pairs(familiesTbl) do
				if string.lower(name) == familyNameLower then
					familyRarity = string.lower(rarity)
					break
				end
			end
			if familyRarity then break end
		end
	end

	local stopRolling = false
	if targets and table.find(targets, familyNameLower) then stopRolling = true end
	if rarities and table.find(rarities, familyRarity) then stopRolling = true end
	if familyRarity == "mythical" or familyRarity == "mythic" then stopRolling = true end

	if stopRolling then
		getgenv().AutoRoll = false
		pcall(function()
			if Toggles.AutoRollToggle then
				Toggles.AutoRollToggle:SetValue(false)
			end
		end)

		if getgenv().StoreFamily then
			local count = 0
			local success = getRemote:InvokeServer("Family", "Store")
			if not success then
				repeat
					count += 1
					success = getRemote:InvokeServer("Family", "Store")
				until success or count >= 3
			end
			if success then
				Library:Notify({
					Title = "Mist Hub",
					Description = "Stored Family: " .. familyName,
					Time = 5,
				})
			else
				Library:Notify({
					Title = "Mist Hub",
						Description = "Failed to store family: " .. familyName .. " " .. "(" .. familyRarity .. ")",
						Time = 5,
					})
			end
		end

		if (familyRarity == "mythical" or familyRarity == "mythic") and getgenv().MythicalFamilyWebhook and webhook and webhook ~= "" then
			local payload = {
				content = "MYTHICAL FAMILY ROLLED! @everyone",
				embeds = {{
					title = "Family Roll Success",
					color = 0xff0000,
					fields = {
						{
							name = "Information",
							value =
									"User: ||" .. lp.Name .. "||\n" ..
									"Family: " .. familyName,
							inline = true
						}
					},
					footer = {
						text = "Mist Hub",
						icon_url = nil
					},
					timestamp = DateTime.now():ToIsoDate()
				}}
			}

			request({
				Url = webhook,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode(payload)
			})
		end

		pcall(function()
			Library:Notify({
				Title = "Mist Hub",
				Description = "Target family rolled: " .. familyName,
				Time = 5,
			})
		end)

		return
	end

	if PlayerGui.Interface.Warning.Prompt.Visible then
		UseButton(PlayerGui.Interface.Warning.Prompt.Main.Yes)
		task.wait(0.1)
	end

	if familyFrame and not familyFrame.Visible then
		UseButton(PlayerGui.Interface.Customisation.Categories.Family.Interact)
		task.wait(1)
	end

	if rollButton then
		UseButton(rollButton)
	end
end

local function DeleteMap()
	if isMap and mapData and mapData.Map.Type == "Raids" then return end
	task.spawn(function()
		while getgenv().DeleteMap and workspace:FindFirstChild("Climbable") do
			
			for _, v in workspace.Climbable:GetChildren() do
				if v:IsA("Model") and v.Name ~= "Utgard" then continue end
				v:Destroy()
			end

			for _, v in workspace.Unclimbable:GetChildren() do
				if v.Name == "Walls" or v.Name == "Trees" or v.Name == "Background" then
					v:Destroy()
				end
			end
			task.wait(3)
		end
	end)
end


-- auto Escape listener
getgenv().AutoEscape = false
postRemote.OnClientEvent:Connect(function(...)
	local args = {...}
	if getgenv().AutoEscape and args[1] == "Titans" and args[2] == "Grab_Event" then
		game:GetService("Players").LocalPlayer.PlayerGui.Interface.Buttons.Visible = not getgenv().AutoEscape
		postRemote:FireServer("Attacks", "Slash_Escape")
	end
end)

